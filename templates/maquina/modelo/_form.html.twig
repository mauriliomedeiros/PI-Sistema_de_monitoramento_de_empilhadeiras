{{ form_start(form) }}
<div class="container col-md-12">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Cadastro de Modelo</h5>
        </div>
        <div class="card-body">
            <fieldset>
                <legend>Dados cadastrais</legend>
                <div class="form-row">
                    <div class="form-group col-md-12">
                        <span>Fabricante: *</span>
                        {{ form_row(form.fabricante) }}
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group col-md-10">
                        <span>Nome: *</span>
                        {{ form_row(form.nome) }}
                    </div>
                    <div class="form-group col-md-2">
                        <span>Carga total (kg): *</span>
                        {{ form_row(form.cargaTotal) }}
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group col-md-6">
                        <span>Características: *</span>
                        {{ form_row(form.caracteristicas) }}
                    </div>
                    <div class="form-group col-md-6">
                        <span>Aplicações: *</span>
                        {{ form_row(form.aplicacoes) }}
                    </div>
                </div>
            </fieldset>
            <fieldset>
                <legend>Sistema</legend>
                <div class="form-row">
                    <div class="form-group col-md-4">
                        <span>Ativo: *</span>
                        {{ form_row(form.ativo) }}
                    </div>
                </div>
            </fieldset>
        </div>
        <div class="card-footer">
            <div class="d-flex justify-content-between">
                <a href="{{ path('maquina_modelo_index') }}" class="btn btn-info">
                    Voltar
                </a>
                <button type="submit" class="btn btn-success">
                    {{ button_label|default('Salvar') }}
                </button>
            </div>
        </div>


    </div>
</div>
{{ form_widget(form._token) }}
{{ form_end(form, {'render_rest': false}) }}