{% extends 'base.html.twig' %}
{% block content %}
    <br>
    <div class="container col-md-12">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0 text-center">Fabricantes</h5>
            </div>
            <div class="card-header d-flex justify-content-between">
                {% if is_granted('ROLE_ADMIN') %}
                    <a href="{{ path('maquina_fabricante_new') }}" class="btn btn-success">
                        Novo fabricante
                    </a>
                {% endif %}
                <a href="{{ path('app_dashboard') }}" class="btn btn-info">
                    Voltar
                </a>
            </div>
            <div class="card-body p-3">
                <table class="table table-striped table-hover w-100">
                    <thead class="thead-light">
                    <tr>
                        <th style="width: 5%">ID</th>            {# col-md-1 ~ 1/12 = 8.33%, ajustei para 5% pra ser mais compacto #}
                        <th style="width: 70%">Nome</th>      {# col-md-2 #}
                        <th style="width: 10%">Ativo</th> {# col-md-4 #}
                        <th style="width: 15%">Ações</th>        {# col-md-2 #}
                    </tr>
                    </thead>
                    <tbody>
                    {% for fabricante in fabricantes %}
                        <tr>
                            <td>{{ fabricante.id }}</td>
                            <td>{{ fabricante.nome }}</td>
                            <td>{{ fabricante.ativo ? 'Sim' : 'Não' }}</td>
                            <td>
                                <a href="{{ path('maquina_fabricante_show', {'id': fabricante.id}) }}" class="btn btn-sm btn-outline-primary">Ver</a>
                                {% if is_granted('ROLE_ADMIN') %}
                                    <a href="{{ path('maquina_fabricante_edit', {'id': fabricante.id}) }}" class="btn btn-sm btn-outline-secondary">Editar</a>
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="7" class="text-center">Nenhum registro encontrado</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
{% endblock %}