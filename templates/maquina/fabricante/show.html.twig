{% extends 'base.html.twig' %}

{% block content %}
    <br>
    <div class="container col-md-12">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">Detalhes do fabricante ID: {{ fabricante.id }}</h5>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-2 font-weight-bold">Fabricante:</div>
                    <div class="col-md-4">{{ fabricante.nome }}</div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-2 font-weight-bold">Ativo:</div>
                    <div class="col-md-4">{{ fabricante.ativo ? 'Sim' : 'Não' }}
                    </div>
                </div>
            </div>

            <div class="card-footer d-flex justify-content-between">
                <a href="{{ path('maquina_fabricante_index') }}" class="btn btn-info">Voltar</a>
                {% if is_granted('ROLE_ADMIN') %}
                    <a href="{{ path('maquina_fabricante_edit', {'id': fabricante.id}) }}" class="btn btn-warning">Editar</a>
                {% endif %}
            </div>
        </div>
    </div>

{% endblock %}