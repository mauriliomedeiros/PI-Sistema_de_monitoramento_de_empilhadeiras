{{ form_start(form) }}
<div class="container col-md-12">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Cadastro de Cliente</h5>
        </div>

        <div class="card-body">
            <fieldset>
                <legend>Dados cadastrais</legend>
                <div class="form-row">
                    <div class="form-group col-md-10">
                        <span>Razão Social: *</span>
                        {{ form_row(form.razao_social) }}
                    </div>
                    <div class="form-group col-md-2">
                        <span>CNPJ: *</span>
                        {{ form_row(form.cnpj) }}
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group col-md-10">
                        <span>Nome fantasia: *</span>
                        {{ form_row(form.nome_fantasia) }}
                    </div>
                    <div class="form-group col-md-2">
                        <span>Inscrição estadual:</span>
                        {{ form_row(form.inscricaoEstadual) }}
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group col-md-6">
                        <span>Endereço: *</span>
                        {{ form_row(form.endereco) }}
                    </div>
                    <div class="form-group col-md-2">
                        <span>Cidade: *</span>
                        {{ form_row(form.cidade) }}
                    </div>
                    <div class="form-group col-md-2">
                        <span>Estado: *</span>
                        {{ form_row(form.estado) }}
                    </div>
                    <div class="form-group col-md-2">
                        <span>CEP: *</span>
                        {{ form_row(form.cep) }}
                    </div>
                </div>
            </fieldset>
            <fieldset>
                <legend>Contato</legend>
                <div class="form-row">
                    <div class="form-group col-md-6">
                        <span>Nome responsável: *</span>
                        {{ form_row(form.nomeResponsavel) }}
                    </div>
                    <div class="form-group col-md-4">
                        <span>E-mail: *</span>
                        {{ form_row(form.email) }}
                    </div>
                    <div class="form-group col-md-2">
                        <span>Telefone: *</span>
                        {{ form_row(form.telefone) }}
                    </div>
                </div>
            </fieldset>
            <fieldset>
                <legend>Sistema</legend>
                <div class="form-row">
                    <div class="form-group col-md-4">
                        <span>Ativo: *</span>
                        {{ form_row(form.ativo) }}
                    </div>
                </div>
            </fieldset>
        </div>
        <div class="card-footer">
            <div class="d-flex justify-content-between">
                <a href="{{ path('cliente_index') }}" class="btn btn-info">
                    Voltar
                </a>
                <button type="submit" class="btn btn-success">
                    {{ button_label|default('Salvar') }}
                </button>
            </div>
        </div>


    </div>
</div>
{{ form_widget(form._token) }}
{{ form_end(form, {'render_rest': false}) }}
