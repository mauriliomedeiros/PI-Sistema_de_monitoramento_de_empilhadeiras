{% extends 'base.html.twig' %}

{% block content %}
    <br>
    <div class="container col-md-12">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">Detalhes do local ID: {{ local.id }}</h5>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-2 font-weight-bold">Cliente:</div>
                    <div class="col-md-10">{{ local.cliente.razaoSocial }}</div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-2 font-weight-bold">Nome:</div>
                    <div class="col-md-10">{{ local.nome }}</div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-2 font-weight-bold">Endereço:</div>
                    <div class="col-md-10">{{ local.endereco }}, {{ local.cidade }}, {{ local.estado }} - CEP: {{ local.cep }}</div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-2 font-weight-bold">Observação:</div>
                    <div class="col-md-10">{{ local.observacao }}</div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-2 font-weight-bold">Ativo:</div>
                    <div class="col-md-4">{{ local.ativo ? 'Sim' : 'Não' }}
                    </div>
                </div>
            </div>

            <div class="card-footer d-flex justify-content-between">
                <a href="{{ path('local_index') }}" class="btn btn-info">Voltar</a>
                <a href="{{ path('local_edit', {'id': local.id}) }}" class="btn btn-warning">Editar</a>
            </div>
        </div>
    </div>

{% endblock %}