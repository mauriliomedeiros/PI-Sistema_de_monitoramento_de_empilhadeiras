{% extends 'base.html.twig' %}
{% block content %}
    <br>
    <div class="container col-md-12">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0 text-center">Checklists</h5>
        </div>
        <div class="card-header d-flex justify-content-between">
            <a href="{{ path('checklist_new') }}" class="btn btn-success">
                Novo checklist
            </a>
            <a href="{{ path('app_dashboard') }}" class="btn btn-info">
                Voltar
            </a>
        </div>
        <div class="card-body p-3">
            <table class="table table-striped table-hover w-100">
                <thead class="thead-light">
                <tr>
                    <th style="width: 5%">ID</th>            {# col-md-1 ~ 1/12 = 8.33%, ajustei para 5% pra ser mais compacto #}
                    <th style="width: 20%">Fabricante/Modelo</th> {# col-md-4 #}
                    <th style="width: 15%">Máquina S/N</th> {# col-md-4 #}
                    <th style="width: 20%">Operador</th>      {# col-md-2 #}
                    <th style="width: 15%">Data e hora</th>      {# col-md-2 #}
                    <th style="width: 10%">Ativo</th> {# col-md-4 #}
                    <th style="width: 15%">Ações</th>        {# col-md-2 #}
                </tr>
                </thead>
                <tbody>
                {% for checklist in checklists %}
                    <tr>
                        <td>{{ checklist.id }}</td>
                        <td>{{ checklist.maquina.modelo.fabricante.nome }} {{ checklist.maquina.modelo.nome }}</td>
                        <td>{{ checklist.maquina.serialNumber|default('') }}</td>
                        <td>{{ checklist.operador.nome|default('') }}</td>
                        <td>{{ checklist.dataHoraRealizado|date('d/m/Y H:i') }}</td>
                        <td>{{ checklist.ativo ? 'Sim' : 'Não' }}</td>
                        <td>
                            <a href="{{ path('checklist_show', {'id': checklist.id}) }}" class="btn btn-sm btn-outline-primary">Ver</a>
                            <a href="{{ path('checklist_edit', {'id': checklist.id}) }}" class="btn btn-sm btn-outline-secondary">Editar</a>
                            <a href="{{ path('checklist_alterar_status', {'id': checklist.id}) }}" class="btn btn-sm
                                {% if checklist.ativo %}
                                    btn-outline-danger">Inativar
                                {% else %}
                                    btn-outline-success">Ativar
                                {% endif %}
                            </a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="7" class="text-center">Nenhum registro encontrado</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}