{% extends 'base.html.twig' %}

{% block content %}
    <br>
    <div class="container col-md-12">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">Detalhes do usuário ID: {{ usuario.id }}</h5>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-2 font-weight-bold">Nome:</div>
                    <div class="col-md-4">{{ usuario.nome }}</div>
                    <div class="col-md-2 font-weight-bold">Sobrenome:</div>
                    <div class="col-md-4">{{ usuario.sobrenome }}</div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-2 font-weight-bold">Usuário:</div>
                    <div class="col-md-4">{{ usuario.username }}</div>
                    <div class="col-md-2 font-weight-bold">Função:</div>
                    <div class="col-md-4">{{ usuario.role }}</div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-2 font-weight-bold">Ativo:</div>
                    <div class="col-md-4">{{ usuario.ativo ? 'Sim' : 'Não' }}
                    </div>
                </div>
            </div>
            <div class="card-footer d-flex justify-content-between">
                <a href="{{ path('core_usuario_index') }}" class="btn btn-info">Voltar</a>
                <a href="{{ path('core_usuario_edit', {'id': usuario.id}) }}" class="btn btn-warning">Editar</a>
            </div>
        </div>
    </div>

{% endblock %}