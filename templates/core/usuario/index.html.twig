{% extends 'base.html.twig' %}

{% block content %}
    <br>
    <div class="container col-md-12">

        <div class="card shadow-sm">

            <div class="card-header bg-primary text-white">
                <h5 class="mb-0 text-center">Usuários</h5>
            </div>
            <div class="card-header d-flex justify-content-between">
                <a href="{{ path('core_usuario_new') }}" class="btn btn-success">
                    Novo usuário
                </a>
                <a href="{{ path('app_dashboard') }}" class="btn btn-info">
                    Voltar
                </a>
            </div>
            <div class="card-body p-3">
                <table class="table table-striped table-hover w-100">
                    <thead class="thead-light">
                    <tr>
                        <th style="width: 5%">ID</th>            {# col-md-1 ~ 1/12 = 8.33%, ajustei para 5% pra ser mais compacto #}
                        <th style="width: 30%">Nome</th>      {# col-md-2 #}
                        <th style="width: 25%">Usuário</th>   {# col-md-1 #}
                        <th style="width: 15%">Função</th> {# col-md-1 #}
                        <th style="width: 10%">Ativo</th> {# col-md-4 #}
                        <th style="width: 15%">Ações</th>        {# col-md-2 #}
                    </tr>
                    </thead>
                    <tbody>
                    {% for usuario in usuarios %}
                        <tr>
                            <td>{{ usuario.id }}</td>
                            <td>{{ usuario.nome }} {{ usuario.sobrenome }}</td>
                            <td>{{ usuario.username }}</td>
                            <td>{{ usuario.role }}</td>
                            <td>{{ usuario.ativo ? 'Sim' : 'Não' }}</td>
                            <td>
                                <a href="{{ path('core_usuario_show', {'id': usuario.id}) }}" class="btn btn-sm btn-outline-primary">Ver</a>
                                <a href="{{ path('core_usuario_edit', {'id': usuario.id}) }}" class="btn btn-sm btn-outline-secondary">Editar</a>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="7" class="text-center">Nenhum registro encontrado</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

{% endblock %}

