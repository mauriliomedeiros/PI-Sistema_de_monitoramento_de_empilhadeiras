{{ form_start(form) }}
<div class="container col-md-12">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Cadastro de Usuário</h5>
        </div>
        <div class="card-body">
            <fieldset>
                <legend>Dados cadastrais</legend>
                <div class="form-row">
                    <div class="form-group col-md-6">
                        <span>Nome: *</span>
                        {{ form_row(form.nome) }}
                    </div>
                    <div class="form-group col-md-6">
                        <span>Sobrenome: *</span>
                        {{ form_row(form.sobrenome) }}
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group col-md-6">
                        <span>Username: *</span>
                        {{ form_row(form.username) }}
                    </div>
                    <div class="form-group col-md-6">
                        <span>Senha: *</span>
                        {{ form_row(form.password) }}
                    </div>
                </div>
            </fieldset>
            <fieldset>
                <legend>Sistema</legend>
                <div class="form-row">
                    <div class="form-group col-md-6">
                        <span>Ativo: *</span>
                        {{ form_row(form.ativo) }}
                    </div>
                    <div class="form-group col-md-6">
                        <span>Função: *</span>
                        {{ form_row(form.role) }}
                    </div>
                </div>
            </fieldset>
        </div>
        <div class="card-footer">
            <div class="d-flex justify-content-between">
                <a href="{{ path('core_usuario_index') }}" class="btn btn-info">
                    Voltar
                </a>
                <button type="submit" class="btn btn-success">
                    {{ button_label|default('Salvar') }}
                </button>
            </div>
        </div>
    </div>
</div>
{{ form_widget(form._token) }}
{{ form_end(form, {'render_rest': false}) }}